# Copia este archivo como .env y pon los datos de TU PostgreSQL local.
# El archivo .env no se sube a GitHub (está en .gitignore).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab_catalog
DB_USER=postgres
DB_PASSWORD=tu_contraseña

# Opcional: URL de la API que usa Streamlit (por defecto http://127.0.0.1:8000)
# API_BASE_URL=http://127.0.0.1:8000
